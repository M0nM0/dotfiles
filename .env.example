# Dotfiles環境変数テンプレート
# このファイルを ~/.env にコピーして使用してください

# ====================
# GitHub
# ====================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ====================
# MCP設定
# ====================
# プロジェクトパス（direnvで自動設定）
MCP_PROJECT_PATH=${PWD}

# ====================
# 社内PC専用（必要に応じてコメント解除）
# ====================
# ATLASSIAN_CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
# ATLASSIAN_USERNAME=your.email@company.com
# ATLASSIAN_TOKEN=ATATT...
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_USERNAME=your.email@company.com
# JIRA_TOKEN=ATATT...

# ====================
# その他のAPI（必要に応じて追加）
# ====================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ====================
# AI コミットメッセージ生成（geminicommit）
# ====================
# Google Gemini APIキー
# https://aistudio.google.com/app/apikey から取得
GEMINI_API_KEY=
