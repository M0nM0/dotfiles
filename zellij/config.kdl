// テーマ
theme "dracula"

// デフォルトシェル
default_shell "zsh"

// 起動時に Zellij の tips を出さない
show_startup_tips false

// セッション名とタブのバーを上に、キーヒントのバーを下に置く (layouts/zjstatus-top.kdl)
default_layout "zjstatus-top"

// pane の周囲の枠を出さない (分割時は pane の間に区切り線だけが出る)
pane_frames false

// マウス
mouse_mode true

// macOS のクリップボード連携
copy_command "pbcopy"

// スクロールバックを開くエディタ (EditScrollback)
scrollback_editor "nvim"

// セッション復活時に pane の表示内容も戻す (保存はスクロールバック 1000 行まで)
serialize_pane_viewport true
scrollback_lines_to_serialize 1000

// セッション復活時に claude を直前の会話の続きで起動する (-c/-r などの指定済みならそのまま)
post_command_discovery_hook r#"echo "$RESURRECT_COMMAND" | sed -E "/^claude( |\$)/{/ (-c|--continue|-r|--resume)( |\$)/!s/^claude/claude --continue/;}""#

// キーバインド: tmux と同じ prefix (Ctrl-j) + キーで操作する
keybinds {
    shared_except "locked" {
        unbind "Ctrl b"
        bind "Ctrl j" { SwitchToMode "Tmux"; }
        // シェル・vim のキー (Backspace, 履歴など) と衝突するため外す
        unbind "Ctrl h" "Ctrl o" "Ctrl p" "Ctrl n" "Ctrl s" "Ctrl t"
        // 確認なしでセッションごと終了するため外す (終了は prefix+s の Session モードから)
        unbind "Ctrl q"
        // アプリのキーと衝突するため外す
        unbind "Ctrl g" "Alt i" "Alt o"
        bind "Alt g" { SwitchToMode "Locked"; }
        // Alt h/l (既定) は pane のフォーカス移動、Shift 付きはタブの移動
        bind "Alt Shift h" "Alt H" { GoToPreviousTab; }
        bind "Alt Shift l" "Alt L" { GoToNextTab; }
        bind "Alt Shift ," "Alt <" { MoveTab "Left"; }
        bind "Alt Shift ." "Alt >" { MoveTab "Right"; }
    }
    locked {
        unbind "Ctrl g"
        bind "Alt g" { SwitchToMode "Normal"; }
    }
    tmux {
        unbind "Ctrl b"
        // prefix を 2 回押すと Ctrl-j (LF) をアプリに渡す
        bind "Ctrl j" { Write 10; SwitchToMode "Normal"; }

        // pane 移動
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }

        // tab (tmux の window) 切り替え
        bind "Ctrl h" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Ctrl l" { GoToNextTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // pane リサイズ
        bind "H" { Resize "Increase Left"; SwitchToMode "Normal"; }
        bind "J" { Resize "Increase Down"; SwitchToMode "Normal"; }
        bind "K" { Resize "Increase Up"; SwitchToMode "Normal"; }
        bind "L" { Resize "Increase Right"; SwitchToMode "Normal"; }

        // 分割・tab 作成・tab 名変更
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }

        // タブ一覧を fzf で開き、プレビューを見ながら移動する (scripts/tab-picker.sh)
        bind "w" {
            Run "sh" "-c" "exec ~/.config/zellij/scripts/tab-picker.sh" {
                floating true
                close_on_exit true
                name "tabs"
                x "2%"
                y "5%"
                width "95%"
                height "90%"
            };
            SwitchToMode "Normal"
        }

        // スクロール、スクロールバックを nvim で開く、画面とスクロールバックのクリア
        bind "v" { SwitchToMode "Scroll"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "X" { Clear; SwitchToMode "Normal"; }

        // 外したデフォルトのモードへの入口
        bind "s" { SwitchToMode "Session"; }
        bind "t" { SwitchToMode "Tab"; }
        bind "m" { SwitchToMode "Move"; }
    }
}
