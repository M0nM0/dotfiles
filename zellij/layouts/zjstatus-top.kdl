// zjstatus のバーを上に置く。cmux のタブの帯に寄せ、選択中のタブは画面と同じ背景にしてアイコンを青くする
// 左にセッション名、右には prefix 中などのモードだけを出す。キーヒントは下の status-bar に任せる
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
                color_strip "#22252b"
                color_div   "#33373e"
                color_text  "#eceef2"
                color_tab   "#a3a9b3"
                color_dim   "#6a707a"
                color_icon  "#b3b9c3"
                color_blue  "#4c9aff"
                color_warn  "#ffb340"
                color_red   "#ff6961"

                format_left  "#[bg=$strip]  #[fg=$dim,bg=$strip] #[fg=$text,bg=$strip,bold]{session}#[bg=$strip]    {tabs}"
                format_right "{mode}"
                format_space "#[bg=$strip]"

                // 選択中のタブは bg=default でターミナルの背景色 (透過を含む) のまま抜く
                // 番号は prefix + 数字で移動する先のタブ番号
                tab_normal    "#[bg=$strip]   #[fg=$icon,bg=$strip]󰆍 {index}  #[fg=$tab,bg=$strip]{name}   "
                tab_active    "#[bg=default]   #[fg=$blue,bg=default]󰆍 {index}  #[fg=$text,bg=default,bold]{name}   "
                tab_separator "#[fg=$div,bg=$strip]│"

                // zjstatus は画面幅に合わせて切り詰めず、はみ出すとバーが折り返して消えるため、表示するタブ数を絞る
                tab_display_count         "3"
                tab_truncate_start_format "#[fg=$dim,bg=$strip]  ‹ +{count}"
                tab_truncate_end_format   "#[fg=$dim,bg=$strip]+{count} ›  "

                mode_normal     "#[bg=$strip]"
                mode_tmux       "#[fg=$warn,bg=$strip]● #[fg=$warn,bg=$strip,bold]PREFIX#[bg=$strip]  "
                mode_locked     "#[fg=$red,bg=$strip]● #[fg=$red,bg=$strip,bold]LOCKED#[bg=$strip]  "
                mode_scroll     "#[fg=$blue,bg=$strip]● #[fg=$blue,bg=$strip,bold]SCROLL#[bg=$strip]  "
                mode_session    "#[fg=$blue,bg=$strip]● #[fg=$blue,bg=$strip,bold]SESSION#[bg=$strip]  "
                mode_rename_tab "#[fg=$blue,bg=$strip]● #[fg=$blue,bg=$strip,bold]RENAME#[bg=$strip]  "
            }
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
}
